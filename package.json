{
  "name": "AutoSocial",
  "version": "1.0.0",
  "description": "",
  "main": "index.js",
  "scripts": {
    "dev": "concurrently -n back,front -c blue,green \"pnpm --filter ./backend dev\" \"pnpm --filter ./frontend dev\"",
