    "dev:frontend": "pnpm --filter ./frontend dev",
    "start": "pnpm --filter ./frontend build && pnpm --filter ./backend build && pnpm --filter ./backend start",
    "fmt": "oxfmt",
    "fmt:check": "oxfmt --check"
  },
  "keywords": [],
