# ─── AutoSocial backend environment ──────────────────────────────────────────────
# Copy this file to `.env` (same directory) and fill in your values:
#   cp .example.env .env
#
# The server fails fast on startup if any REQUIRED variable is missing.

# ─── Server (REQUIRED) ─────────────────────────────────────────────────────────
NODE_ENV=development
PORT=3000
# Public URL of the frontend (used for OAuth redirect URIs and CORS allowlist).
# Dev default assumes `pnpm --filter ./frontend dev` on port 5173.
FRONTEND_URL=http://localhost:5173
LOG_LEVEL=info

# ─── Database (REQUIRED) ───────────────────────────────────────────────────────
# Local MongoDB or MongoDB Atlas connection string.
DATABASE_URL=mongodb://localhost:27017/autosocial

# ─── Auth (REQUIRED) ───────────────────────────────────────────────────────────
# Minimum 32 characters. Generate with: openssl rand -hex 32
BETTER_AUTH_SECRET=replace-this-with-at-least-32-random-characters
# Base URL where the API itself is reachable (better-auth uses it for links).
BETTER_AUTH_URL=http://localhost:3000

# ─── Token encryption (REQUIRED) ───────────────────────────────────────────────
# 32 random bytes as 64 hex chars. Used to encrypt OAuth tokens at rest (AES-256-GCM).
# Generate with: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
# WARNING: changing this after integrations are connected invalidates stored tokens.
TOKEN_ENCRYPTION_KEY=<64-hex-chars>

# ─── AI (REQUIRED) ─────────────────────────────────────────────────────────────
OPENAI_API_KEY=sk-proj-your-openai-key-here
# Optional: override base URL for OpenAI-compatible APIs (Groq, Ollama, etc.)
# OPENAI_BASE_URL=https://api.groq.com/openai/v1
# Optional model overrides (defaults shown):
# TEXT_TO_TEXT_MODEL_NAME=gpt-4o
# IMAGE_TO_TEXT_MODEL_NAME=gpt-4o
# IMAGE_MODEL_NAME=dall-e-3
# CHAT_TEMPERATURE=1
# CHAT_MAX_TOKENS=4096

# ─── Media storage / S3-compatible (REQUIRED) ──────────────────────────────────
# Works with AWS S3 or any S3-compatible store (Cloudflare R2, MinIO, ...).
# For R2: AWS_REGION=auto and S3_ENDPOINT=https://<account-id>.r2.cloudflarestorage.com
AWS_REGION=auto
AWS_S3_BUCKET=your-bucket-name
AWS_ACCESS_KEY_ID=your-access-key-id
AWS_SECRET_ACCESS_KEY=your-secret-access-key
S3_ENDPOINT=https://your-account-id.r2.cloudflarestorage.com
# Public base URL for media (e.g. https://pub-<id>.r2.dev or a CDN/custom domain).
# Recommended: without it, media links are presigned URLs that expire after
# S3_PRESIGNED_URL_EXPIRY seconds. Posts store the S3 key and the publish job
# mints a fresh URL at publish time, so scheduled posts keep working either way.
# S3_PUBLIC_URL=https://pub-your-hash.r2.dev
# S3_PRESIGNED_URL_EXPIRY=300
# Media upload limits: images 10MB; video (MP4/MOV/WebM) 200MB.

# ─── Social providers (OPTIONAL — needed only to connect that network) ─────────
# Facebook / Instagram — create an app at https://developers.facebook.com/apps/
# Required permissions: pages_show_list, business_management, pages_manage_posts,
#   pages_manage_engagement, pages_read_engagement, read_insights,
#   instagram_basic, instagram_content_publish
# FACEBOOK_APP_ID=
# FACEBOOK_APP_SECRET=

# X (Twitter) — create an app at https://developer.twitter.com/en/portal/dashboard
# Required access: Read and Write. Auth type: OAuth 1.0a User Context
# X_API_KEY=
# X_API_SECRET=
# Optional: override the X OAuth callback base URL (defaults to FRONTEND_URL)
# X_URL=https://your-app.com

# LinkedIn — create an app at https://www.linkedin.com/developers/apps/
# Required products: Share on LinkedIn, Sign In with LinkedIn using OpenID Connect,
#   Marketing Developer Platform (for company pages)
# LINKEDIN_CLIENT_ID=
# LINKEDIN_CLIENT_SECRET=
